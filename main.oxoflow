# oxo-flow-varlociraptor
#
# Small and structural variant calling with Varlociraptor.
# oxo-flow port of snakemake-workflows/dna-seq-varlociraptor v6.10.0
# (https://github.com/snakemake-workflows/dna-seq-varlociraptor, MIT).
#
# Scope: the default-parameter execution path for one tumor sample group
# ("SRR702070_group", sample "SRR702070") — pangenome (vg giraffe) mapping,
# freebayes + delly candidate calling, Varlociraptor calling with scenario
# "some_id" (present + somatic_tumor_high + somatic_tumor_medium events),
# FDR control over 8 variant types, VEP annotation, and the datavzrd report.
# Rule-level fidelity notes (upstream rule -> ported rule) live in the module
# files; deviations are summarized in README.md and metadata.json.
#
# Upstream scatter.calling(16) is collapsed to a single chunk (scatteritem=0);
# all "results/..." paths follow the upstream layout so commands are
# byte-identical to the snakemake-wrappers ports used upstream.

[workflow]
name = "oxo-flow-varlociraptor"
description = "Small and structural variant calling with Varlociraptor (port of snakemake-workflows/dna-seq-varlociraptor v6.10.0)"
[config]
# Path to the raw paired-end FASTQs of the single sample (upstream
# config/units.tsv points at absolute /projects/... paths; the port reads
# from the repository fixtures instead).
reads_dir = "test/fixtures/raw"

# Skip the ref:: download rules (genome, annotation, VEP cache/plugins,
# pangenome, REVEL, known variants — ~5 GB of public databases). Set to
# true when you have pre-placed the files at the resource paths the rules
# declare (see README "Reference databases"); the downloads are hardcoded
# upstream URLs and need unimpeded network access.
skip_ref_downloads = false

# ---------------------------------------------------------------------------
# Gated branch modules (all off by default; the default path is unchanged).
# Each key maps to an upstream config section, see the module headers.
# ---------------------------------------------------------------------------

# upstream config: trimming (get_sra / fastp rules). The default path has no
# trimming configured — reads pass through mapping::merge_trimmed_fastqs.
trimming_activate = false

# upstream config: primers/trimming (rules assign_primers ... build_primer_regions).
# primers_fa1/primers_fa2 are the upstream primers/trimming/primers_fa{1,2} fasta
# files (empty upstream default = primers flow off); fa2 empty means single-end
# primer fasta.
primers_activate = false
primers_fa1 = ""
primers_fa2 = ""

# upstream config: maf/activate (group_bcf_to_vcf + group_vcf_to_maf).
maf_activate = false

# upstream config: population/db/activate + path/alias/fdr/events
# (rules clean_population_db / population_filter_variants / population_db_update).
population_db_activate = false
population_db_path = "resources/population_db.variants.bcf"
population_db_alias = "tumor"
population_db_fdr = 0.05
population_db_events = "somatic_tumor_high,somatic_tumor_medium"

# upstream config: linear-reference (bwa) aligner branch of mapping.smk
# (map_reads_bwa + ref.smk bwa_index). The default path aligns with vg
# giraffe to the pangenome (ref/pangenome/activate = true upstream).
bwa_align_activate = false

# upstream config: mutational_burden/activate + events
# (calculate_covered_coding_sites + estimate_mutational_burden; events are
# comma-joined, split to space-separated in the rule shells).
mutational_burden_activate = false
mutational_burden_events = "somatic_tumor_low,somatic_tumor_medium,somatic_tumor_high"

# upstream config: mutational_signatures/activate
# (create_mutational_context_file ... plot_mutational_signatures; upstream
# default events = [some_id], samples = [tumor], frozen in the module).
mutational_signatures_activate = false

# upstream config: benchmarking (Snakefile rule benchmark / benchmarking.smk;
# the full CHM-eval flow is ported, except the chm sample group vertical
# slice (see module header)).
benchmarking_activate = false

# upstream config: calc_consensus_reads/activate (consensus.oxoflow: rbt
# collapse-reads-to-fragments + re-mapping to the linear bwa reference).
# Activating it also needs the bwa reference index (bwa_align_activate or
# primers_activate builds it) and, upstream-faithful,
# markduplicates_extra = "--TAG_DUPLICATE_SET_MEMBERS true" and
# freebayes_min_alternate_count = 1 (see those keys below).
consensus_activate = false

# upstream config: plugins (download_cadd_scores_for_vep; download_revel and
# process_revel_scores are already ported in ref.oxoflow). cadd_build /
# cadd_version / cadd_variant_type are the upstream wildcards of the same
# rule with their upstream defaults.
plugins_activate = false
cadd_build = "GRCh38"
cadd_version = "v1.7"
cadd_variant_type = "snv"

# upstream config: annotations/dgidb (annotate_dgidb; datasources = [DrugBank]).
# Activating dgidb changes which annotated callset the final-calls chain
# consumes upstream (get_final_selected_annotation): set annotation_selection
# below to "dgidb_annotated" together with this key.
dgidb_activate = false

# The annotated-callset selection for gather_annotated_calls (upstream
# get_final_selected_annotation): "db_annotated" (annotations/vcfs active,
# the default), "dgidb_annotated" when dgidb is activated, or "vep_annotated"
# when annotations/vcfs is deactivated.
annotation_selection = "db_annotated"

# upstream config: params/freebayes — the min-alternate-count for candidate
# calling (2, or 1 when calc_consensus_reads is active).
freebayes_min_alternate_count = 2

# upstream config: params/picard/MarkDuplicates + get_markduplicates_extra —
# extra MarkDuplicates arguments (upstream adds
# "--TAG_DUPLICATE_SET_MEMBERS true" when calc_consensus_reads is active;
# empty by default).
markduplicates_extra = ""

# upstream config: fusion calling branch (fusion_calling.smk star_arriba
# meta wrapper: star_index / star_align / arriba / annotate_exons /
# convert_fusions / sort_arriba_calls / bcftools_concat_candidates). With a
# group whose `calling` metadata includes "fusions", the candidates continue
# into the varlociraptor calling flow (calling.smk get_candidate_calls —
# see modules/calling.oxoflow).
fusion_activate = false

# upstream config: target_regions (regions.smk get_target_regions +
# candidate_calling.smk filter_offtarget_variants, see module headers). One
# BED path or a list of BED paths (all merged + chr-stripped by
# regions::get_target_regions); empty (default) = whole-genome calling
# exactly as today. Gate is len(config.target_regions) > 0, so "" and []
# both disable. Note: CLI overrides are single-valued strings
# (--arg target_regions=path or --target-regions=path) — pass a list in
# main.oxoflow itself for multiple files.
target_regions = ""

# ---------------------------------------------------------------------------
# Sample groups (upstream config/samples.tsv: SRR702070 -> SRR702070_group,
# alias "tumor", platform ILLUMINA, purity 1.0, datatype dna, calling variants)
# ---------------------------------------------------------------------------
[[sample_groups]]
name = "SRR702070_group"
samples = ["SRR702070"]

# upstream config/samples.tsv "calling" column (variants | fusions |
# variants,fusions). The default row is "variants"; a group whose mode
# includes "fusions" re-wires the calling flow to consume the arriba
# candidates (calling.smk get_candidate_calls — see modules/calling.oxoflow)
# and additionally requires fusion_activate = true so the fusion candidates
# exist.
[sample_groups.metadata]
calling = "variants"

# ---------------------------------------------------------------------------
# Modules (rule names are namespaced as <namespace>::<rule_name>)
# ---------------------------------------------------------------------------
[[include]]
path = "modules/ref.oxoflow"
namespace = "ref"

[[include]]
path = "modules/mapping.oxoflow"
namespace = "mapping"

[[include]]
path = "modules/qc.oxoflow"
namespace = "qc"

[[include]]
path = "modules/regions.oxoflow"
namespace = "regions"

[[include]]
path = "modules/candidate_calling.oxoflow"
namespace = "candidate_calling"

[[include]]
path = "modules/calling.oxoflow"
namespace = "calling"

[[include]]
path = "modules/annotation.oxoflow"
namespace = "annotation"

[[include]]
path = "modules/filtering.oxoflow"
namespace = "filtering"

[[include]]
path = "modules/table.oxoflow"
namespace = "table"

[[include]]
path = "modules/report.oxoflow"
namespace = "report"

# ---------------------------------------------------------------------------
# Gated branch modules (rules are namespaced as <namespace>::<rule_name> and
# gated via `when = "config.<key>"`; validate counts them unconditionally,
# the executor skips them at run time when the key is false)
# ---------------------------------------------------------------------------
[[include]]
path = "modules/trimming.oxoflow"
namespace = "trimming"

[[include]]
path = "modules/primers.oxoflow"
namespace = "primers"

[[include]]
path = "modules/maf.oxoflow"
namespace = "maf"

[[include]]
path = "modules/population.oxoflow"
namespace = "population"

[[include]]
path = "modules/plugins.oxoflow"
namespace = "plugins"

[[include]]
path = "modules/benchmarking.oxoflow"
namespace = "benchmarking"

[[include]]
path = "modules/mapping_bwa.oxoflow"
namespace = "mapping_bwa"

[[include]]
path = "modules/burden_signatures.oxoflow"
namespace = "burden_signatures"

[[include]]
path = "modules/consensus.oxoflow"
namespace = "consensus"

[[include]]
path = "modules/fusion.oxoflow"
namespace = "fusion"
