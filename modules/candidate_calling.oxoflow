# Candidate calling (upstream workflow/rules/candidate_calling.smk).
#
# Rule map (upstream rule -> this module):
#   freebayes        -> candidate_calling::freebayes   (freebayes v2.7.0 wrapper)
#   delly            -> candidate_calling::delly       (delly v2.3.2 wrapper)
#   fix_delly_calls  -> candidate_calling::fix_delly_calls
#   scatter_candidates -> candidate_calling::scatter_candidates_{freebayes,delly}
#                         (rbt vcf-split; scatter.calling(16) collapsed to 1 chunk)
#   annotate_candidate_variants -> candidate_calling::annotate_candidate_variants_{freebayes,delly}
#                                  (vep annotate v8.0.0 wrapper)
#   filter_candidates_by_annotation -> candidate_calling::filter_candidates_by_annotation_{freebayes,delly}
#   filter_offtarget_variants -> candidate_calling::filter_offtarget_variants_{freebayes,delly}
#   bcf_index (utils.smk)     -> candidate_calling::bcf_index_candidate_{freebayes,delly}
#
# filter_offtarget_variants is off by default (target_regions empty in
# config) — as upstream. With target_regions set, the fixed candidates are
# indexed, offtarget-filtered pre-scatter, and scatter_candidates consumes
# the filtered BCF (upstream input switch).

[workflow]
name = "candidate_calling"

# ---- upstream rule: freebayes ----------------------------------------------
# freebayes v2.7.0 wrapper (--pooled-continuous
# --min-alternate-count 2 --min-alternate-fraction 0.05; region chunks of
# 100 kb intersected with the expanded filtered regions). The min-alternate
# count comes from config (upstream: 2, or 1 when calc_consensus_reads is
# active — set config.freebayes_min_alternate_count to 1 with
# consensus_activate).
[[rules]]
name = "freebayes"
description = "Call candidate variants with freebayes (freebayes v2.7.0 wrapper)"
input = [
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta",
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta.fai",
    "results/regions/SRR702070_group.expanded_regions.filtered.bed",
    "results/recal/SRR702070.bam",
    "results/recal/SRR702070.bai",
]
output = ["results/candidate-calls/freebayes/SRR702070_group/SRR702070_group.bcf"]
shell = '''
if [ ! -s {input[2]} ]; then
    # empty candidate region set (the fixture's reads yield no candidates):
    # emit a valid header-only BCF — upstream would run freebayes-parallel
    # on nothing and die the same way
    printf '##fileformat=VCFv4.2\n#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\n' | \
      bcftools view --output {output} --output-type b 2> {log}
    exit 0
fi
tmpdir=$(mktemp -d) && \
(freebayes-parallel <(bedtools intersect -a <(sed 's#\([0-9]*\):\([0-9]*\)-\([0-9]*\)$#\1\t\2\t\3#' <(fasta_generate_regions.py {input[1]} 100000)) -b {input[2]} | sed 's/\t\([0-9]*\)\t\([0-9]*\)$/:\1-\2/') 96 \
  --fasta-reference {input[0]} --pooled-continuous --min-alternate-count {config.freebayes_min_alternate_count} --min-alternate-fraction 0.05 {input[3]} \
  | bcftools sort --max-mem 205M --temp-dir "$tmpdir" \
  | bcftools view --threads 95 --output {output} --output-type b) 2> {log} && \
rm -rf "$tmpdir"
'''
log = "logs/freebayes/SRR702070_group.log"

[rules.resources]
# upstream runs freebayes-parallel with 96 jobs (the shell's literal 96);
# the port scales the rule's own thread budget to this machine (live:
# resource exhausted on the 64-core box at 96)
threads = 48

[rules.environment]
conda = "envs/freebayes.yaml"

# ---- upstream rule: delly --------------------------------------------------
# delly v2.3.2 wrapper (threads = number of samples = 1).
[[rules]]
name = "delly"
description = "Call structural variant candidates with delly (delly v2.3.2 wrapper)"
input = [
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta",
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta.fai",
    "results/recal/SRR702070.bam",
    "results/recal/SRR702070.bai",
    "results/regions/human.hg38.delly_excluded.bed",
]
output = ["results/candidate-calls/delly/SRR702070_group/SRR702070_group.bcf"]
shell = """
(OMP_NUM_THREADS=1 delly call -g {input[0]} -x {input[4]} {input[2]} \
 | bcftools view --output {output} --output-type b) 2> {log}
"""
log = "logs/delly/SRR702070_group.log"

[rules.resources]
threads = 1

[rules.environment]
conda = "envs/delly.yaml"

# ---- upstream rule: fix_delly_calls ----------------------------------------
# BND records would lead to invalid BCFs after VEP annotation (invalid RLEN).
[[rules]]
name = "fix_delly_calls"
description = "Remove delly BND breakends (invalid after VEP annotation)"
input = ["results/candidate-calls/delly/SRR702070_group/SRR702070_group.bcf"]
output = ["results/candidate-calls/delly/SRR702070_group/SRR702070_group.no_bnds.bcf"]
shell = """
bcftools view -e 'INFO/SVTYPE="BND"' {input} -Ob > {output} 2> {log}
"""
log = "logs/fix_delly_calls/SRR702070_group.log"

[rules.environment]
conda = "envs/bcftools.yaml"

# ---- upstream rule: bcf_index (fixed candidate calls) ----------------------
# utils.smk generic bcf_index instances for the FIXED calls. The index is
# declared (as upstream) so the fixed calls are indexable downstream of the
# offtarget-filter step (target-regions path only).
[[rules]]
name = "bcf_index_candidate_freebayes"
description = "Index the fixed freebayes candidates (bcftools index)"
when = "len(config.target_regions) > 0"
input = ["results/candidate-calls/freebayes/SRR702070_group/SRR702070_group.bcf"]
output = ["results/candidate-calls/freebayes/SRR702070_group/SRR702070_group.bcf.csi"]
shell = "bcftools index {input} 2> {log}"
log = "logs/bcf-index/candidate-calls/freebayes/SRR702070_group/SRR702070_group.log"

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "bcf_index_candidate_delly"
description = "Index the fixed delly candidates (bcftools index)"
when = "len(config.target_regions) > 0"
input = ["results/candidate-calls/delly/SRR702070_group/SRR702070_group.no_bnds.bcf"]
output = ["results/candidate-calls/delly/SRR702070_group/SRR702070_group.no_bnds.bcf.csi"]
shell = "bcftools index {input} 2> {log}"
log = "logs/bcf-index/candidate-calls/delly/SRR702070_group/SRR702070_group.no_bnds.log"

[rules.environment]
conda = "envs/bcftools.yaml"

# ---- upstream rule: filter_offtarget_variants (freebayes) ------------------
# Upstream pins wrapper v2.3.2/bio/bcftools/filter with params.extra="" — the
# wrapper consumes only input[0], so this is a pass-through filter (verified
# against the wrapper source). The regions=... and index inputs are declared
# (as upstream) so get_target_regions and the candidate indexes are guaranteed
# to exist before scatter_candidates; the actual target-region restriction
# happens in regions.oxoflow filter_group_regions_* (bedtools intersect, as
# upstream regions.smk).
[[rules]]
name = "filter_offtarget_variants_freebayes"
description = "Pass-through filter of the fixed freebayes candidates (upstream wrapper v2.3.2/bio/bcftools/filter, extra=\"\")"
when = "len(config.target_regions) > 0"
input = [
    "results/candidate-calls/freebayes/SRR702070_group/SRR702070_group.bcf",
    "results/candidate-calls/freebayes/SRR702070_group/SRR702070_group.bcf.csi",
    "resources/target_regions/target_regions.bed",
]
output = ["results/candidate-calls/freebayes/filtered/SRR702070_group/SRR702070_group.bcf"]
shell = "bcftools filter --output {output} --output-type b {input[0]} 2> {log}"
log = "logs/filter_offtarget_variants/SRR702070_group/SRR702070_group.freebayes.log"

[rules.environment]
conda = "envs/bcftools.yaml"

[[rules]]
name = "filter_offtarget_variants_delly"
description = "Pass-through filter of the fixed delly candidates (upstream wrapper v2.3.2/bio/bcftools/filter, extra=\"\")"
when = "len(config.target_regions) > 0"
input = [
    "results/candidate-calls/delly/SRR702070_group/SRR702070_group.no_bnds.bcf",
    "results/candidate-calls/delly/SRR702070_group/SRR702070_group.no_bnds.bcf.csi",
    "resources/target_regions/target_regions.bed",
]
output = ["results/candidate-calls/delly/filtered/SRR702070_group/SRR702070_group.bcf"]
shell = "bcftools filter --output {output} --output-type b {input[0]} 2> {log}"
log = "logs/filter_offtarget_variants/SRR702070_group/SRR702070_group.delly.log"

[rules.environment]
conda = "envs/bcftools.yaml"

# ---- upstream rule: scatter_candidates (freebayes) -------------------------
# rbt vcf-split with a single output chunk (upstream scatter.calling(16)
# collapsed to scatteritem=0; command is byte-identical).
[[rules]]
name = "scatter_candidates_freebayes"
description = "Split candidate VCF into calling chunks with rbt vcf-split (1 chunk; offtarget-filtered input under target regions, as upstream)"
input = [
    "results/candidate-calls/freebayes/filtered/SRR702070_group/SRR702070_group.bcf",
    "results/candidate-calls/freebayes/SRR702070_group/SRR702070_group.bcf",
]
output = ["results/candidate-calls/freebayes/SRR702070_group/SRR702070_group.0.bcf"]
optional = "any"
shell = """
infile=results/candidate-calls/freebayes/SRR702070_group/SRR702070_group.bcf
if [ -n "{config.target_regions}" ]; then
    infile=results/candidate-calls/freebayes/filtered/SRR702070_group/SRR702070_group.bcf
fi
rbt vcf-split "$infile" {output} 2> {log}
"""
log = "logs/scatter-candidates/freebayes/SRR702070_group/SRR702070_group.log"

[rules.environment]
conda = "envs/rbt.yaml"

# ---- upstream rule: scatter_candidates (delly) -----------------------------
[[rules]]
name = "scatter_candidates_delly"
description = "Split candidate VCF into calling chunks with rbt vcf-split (1 chunk; offtarget-filtered input under target regions, as upstream)"
input = [
    "results/candidate-calls/delly/filtered/SRR702070_group/SRR702070_group.bcf",
    "results/candidate-calls/delly/SRR702070_group/SRR702070_group.no_bnds.bcf",
]
output = ["results/candidate-calls/delly/SRR702070_group/SRR702070_group.0.bcf"]
optional = "any"
shell = """
infile=results/candidate-calls/delly/SRR702070_group/SRR702070_group.no_bnds.bcf
if [ -n "{config.target_regions}" ]; then
    infile=results/candidate-calls/delly/filtered/SRR702070_group/SRR702070_group.bcf
fi
rbt vcf-split "$infile" {output} 2> {log}
"""
log = "logs/scatter-candidates/delly/SRR702070_group/SRR702070_group.log"

[rules.environment]
conda = "envs/rbt.yaml"

# ---- upstream rule: annotate_candidate_variants (freebayes) ----------------
# vep annotate v8.0.0 wrapper (4 threads, extra "--af_gnomade --vcf_info_field
# ANN ", no plugins).
[[rules]]
name = "annotate_candidate_variants_freebayes"
description = "Annotate freebayes candidates with VEP (vep annotate v8.0.0 wrapper)"
input = [
    "results/candidate-calls/freebayes/SRR702070_group/SRR702070_group.0.bcf",
    "resources/vep/cache/.cache_complete",
    "resources/vep/plugins/.plugins_complete",
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta",
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta.fai",
]
output = [
    "results/candidate-calls/freebayes/SRR702070_group/SRR702070_group.0.annotated.bcf",
    "results/candidate-calls/freebayes/SRR702070_group/SRR702070_group.0.stats.html",
]
shell = """
(bcftools view '{input[0]}' | \
 vep --af_gnomade --vcf_info_field ANN --fork 4 --format vcf --vcf \
   --offline --cache --dir_cache resources/vep/cache --cache_version 111 \
   --species homo_sapiens --assembly GRCh38 \
   --fasta {input[3]} --dir_plugins resources/vep/plugins \
   --output_file STDOUT --stats_file {output[1]} \
 | bcftools view -Ob > {output[0]}) 2> {log}
"""
log = "logs/vep/freebayes/SRR702070_group/SRR702070_group.0.annotate_candidates.log"

[rules.resources]
threads = 4

[rules.environment]
conda = "envs/vep.yaml"

# ---- upstream rule: annotate_candidate_variants (delly) --------------------
[[rules]]
name = "annotate_candidate_variants_delly"
description = "Annotate delly candidates with VEP (vep annotate v8.0.0 wrapper)"
input = [
    "results/candidate-calls/delly/SRR702070_group/SRR702070_group.0.bcf",
    "resources/vep/cache/.cache_complete",
    "resources/vep/plugins/.plugins_complete",
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta",
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta.fai",
]
output = [
    "results/candidate-calls/delly/SRR702070_group/SRR702070_group.0.annotated.bcf",
    "results/candidate-calls/delly/SRR702070_group/SRR702070_group.0.stats.html",
]
shell = """
(bcftools view '{input[0]}' | \
 vep --af_gnomade --vcf_info_field ANN --fork 4 --format vcf --vcf \
   --offline --cache --dir_cache resources/vep/cache --cache_version 111 \
   --species homo_sapiens --assembly GRCh38 \
   --fasta {input[3]} --dir_plugins resources/vep/plugins \
   --output_file STDOUT --stats_file {output[1]} \
 | bcftools view -Ob > {output[0]}) 2> {log}
"""
log = "logs/vep/delly/SRR702070_group/SRR702070_group.0.annotate_candidates.log"

[rules.resources]
threads = 4

[rules.environment]
conda = "envs/vep.yaml"

# ---- upstream rule: filter_candidates_by_annotation (freebayes) ------------
# Candidates filter "'MODERATE' in ANN['IMPACT']" (no aux files).
[[rules]]
name = "filter_candidates_by_annotation_freebayes"
description = "Keep MODERATE/HIGH-impact freebayes candidates (vembrane filter)"
input = ["results/candidate-calls/freebayes/SRR702070_group/SRR702070_group.0.annotated.bcf"]
output = ["results/candidate-calls/freebayes/filtered/SRR702070_group/SRR702070_group.0.bcf"]
shell = """
(bcftools norm -Ou --do-not-normalize --multiallelics -any {input} | \
 vembrane filter "'MODERATE' in ANN['IMPACT']" | bcftools sort -Ob > {output}) 2> {log}
"""
log = "logs/filter-calls/annotation/freebayes/SRR702070_group/SRR702070_group.0.log"

[rules.environment]
conda = "envs/vembrane.yaml"

# ---- upstream rule: filter_candidates_by_annotation (delly) ----------------
[[rules]]
name = "filter_candidates_by_annotation_delly"
description = "Keep MODERATE/HIGH-impact delly candidates (vembrane filter)"
input = ["results/candidate-calls/delly/SRR702070_group/SRR702070_group.0.annotated.bcf"]
output = ["results/candidate-calls/delly/filtered/SRR702070_group/SRR702070_group.0.bcf"]
shell = """
(bcftools norm -Ou --do-not-normalize --multiallelics -any {input} | \
 vembrane filter "'MODERATE' in ANN['IMPACT']" | bcftools sort -Ob > {output}) 2> {log}
"""
log = "logs/filter-calls/annotation/delly/SRR702070_group/SRR702070_group.0.log"

[rules.environment]
conda = "envs/vembrane.yaml"
