# Call filtering and FDR control (upstream workflow/rules/filtering.smk).
#
# Rule map (upstream rule -> this module):
#   filter_by_annotation -> filtering::filter_by_annotation
#   gather_calls         -> filtering::gather_calls        (bcftools concat v2.3.2 wrapper)
#   control_fdr          -> filtering::control_fdr_{SNV,INS,DEL,MNV,BND,INV,DUP,REP}
#   merge_calls          -> filtering::merge_calls         (bcftools concat v2.3.2 wrapper)
#   convert_phred_scores -> filtering::convert_phred_scores
#   bcf_index            -> filtering::bcf_index_{filtered,fdr}
#
# Deviations (details in README.md):
#   * filter_odds is not in the default path: mode local-smart and a filter
#     are configured, so control_fdr consumes the "filtered_ann" callset
#     (get_control_fdr_input in common.smk).
#   * The event wildcard is frozen to "some_id" (the only event defined in the
#     upstream default config), and vartype is frozen to the 8 upstream values.
#   * control_fdr fdr 0.05, mode local-smart, no --smart-retain-artifacts.
#   * get_annotation_filter_aux_files resolves config/super_interesting_genes.tsv
#     relative to the workflow root, exactly as upstream.
#   * filter_by_annotation consumes the selected annotated callset via
#     config.annotation_selection (upstream get_annotated_bcf ->
#     get_final_selected_annotation): "db_annotated" by default,
#     "dgidb_annotated" when dgidb is activated.

[workflow]
name = "filtering"

# ---- upstream rule: filter_by_annotation ------------------------------------
# impact_filter + gene_list_filter, expression
# "(('HIGH' in ANN['IMPACT'])) and ((ANN['SYMBOL'] in AUX['super_interesting_genes']))"
# as built by get_annotation_filter_expression.
[[rules]]
name = "filter_by_annotation"
description = "Keep HIGH-impact variants in super-interesting genes (vembrane filter)"
input = [
    "results/calls/{config.annotation_selection}/SRR702070_group/SRR702070_group.variants.0.bcf",
    "results/calls/{config.annotation_selection}/SRR702070_group/SRR702070_group.variants.0.bcf.csi",
    "config/super_interesting_genes.tsv",
]
output = ["results/calls/filtered/filtered_ann/SRR702070_group/some_id/SRR702070_group.variants.0.bcf"]
shell = """
vembrane filter \
  --aux super_interesting_genes=config/super_interesting_genes.tsv \
  "(('HIGH' in ANN['IMPACT'])) and ((ANN['SYMBOL'] in AUX['super_interesting_genes']))" \
  {input[0]} --output-fmt bcf --output {output} &> {log}
"""
log = "logs/filter-calls/annotation/SRR702070_group/some_id/SRR702070_group.variants.0.log"

[rules.environment]
conda = "envs/vembrane.yaml"

# ---- upstream rule: gather_calls --------------------------------------------
# bcftools concat v2.3.2 wrapper (-a) over the annotation-filtered chunks.
[[rules]]
name = "gather_calls"
description = "Gather annotation-filtered chunks (bcftools concat v2.3.2 wrapper)"
input = [
    "results/calls/filtered/filtered_ann/SRR702070_group/some_id/SRR702070_group.variants.0.bcf",
    "results/calls/filtered/filtered_ann/SRR702070_group/some_id/SRR702070_group.variants.0.bcf.csi",
]
output = ["results/calls/filtered/SRR702070_group/some_id/SRR702070_group.variants.filtered_ann.bcf"]
shell = "bcftools concat --output {output} --output-type b -a {input[0]} 2> {log}"
log = "logs/gather-calls/SRR702070_group/some_id/SRR702070_group.variants.filtered_ann.log"

[rules.environment]
conda = "envs/bcftools.yaml"

# ---- upstream rule: control_fdr (one rule per vartype) ----------------------
# varlociraptor filter-calls control-fdr --mode local-smart --fdr 0.05
# with events "present somatic_tumor_high somatic_tumor_medium".
[[rules]]
name = "control_fdr_SNV"
description = "FDR control for SNVs (varlociraptor control-fdr, local-smart, fdr 0.05)"
input = ["results/calls/filtered/SRR702070_group/some_id/SRR702070_group.variants.filtered_ann.bcf"]
output = ["results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.SNV.variants.bcf"]
shell = """
varlociraptor filter-calls control-fdr {input} --mode local-smart --var SNV \
  --events present somatic_tumor_high somatic_tumor_medium --fdr 0.05 > {output} 2> {log}
"""
log = "logs/control-fdr/SRR702070_group/some_id/SRR702070_group.SNV.variants.log"

[rules.environment]
conda = "envs/varlociraptor.yaml"

[[rules]]
name = "control_fdr_INS"
description = "FDR control for insertions (varlociraptor control-fdr, local-smart, fdr 0.05)"
input = ["results/calls/filtered/SRR702070_group/some_id/SRR702070_group.variants.filtered_ann.bcf"]
output = ["results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.INS.variants.bcf"]
shell = """
varlociraptor filter-calls control-fdr {input} --mode local-smart --var INS \
  --events present somatic_tumor_high somatic_tumor_medium --fdr 0.05 > {output} 2> {log}
"""
log = "logs/control-fdr/SRR702070_group/some_id/SRR702070_group.INS.variants.log"

[rules.environment]
conda = "envs/varlociraptor.yaml"

[[rules]]
name = "control_fdr_DEL"
description = "FDR control for deletions (varlociraptor control-fdr, local-smart, fdr 0.05)"
input = ["results/calls/filtered/SRR702070_group/some_id/SRR702070_group.variants.filtered_ann.bcf"]
output = ["results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.DEL.variants.bcf"]
shell = """
varlociraptor filter-calls control-fdr {input} --mode local-smart --var DEL \
