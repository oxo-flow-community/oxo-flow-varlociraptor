[rules.environment]
conda = "envs/varlociraptor.yaml"

[[rules]]
name = "control_fdr_REP"
description = "FDR control for repeat expansions (varlociraptor control-fdr, local-smart, fdr 0.05)"
input = ["results/calls/filtered/SRR702070_group/some_id/SRR702070_group.variants.filtered_ann.bcf"]
output = ["results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.REP.variants.bcf"]
shell = """
varlociraptor filter-calls control-fdr {input} --mode local-smart --var REP \
