log = "logs/control-fdr/SRR702070_group/some_id/SRR702070_group.REP.variants.log"

[rules.environment]
conda = "envs/varlociraptor.yaml"

# ---- upstream rule: merge_calls ---------------------------------------------
# bcftools concat v2.3.2 wrapper (-a) over the 8 vartype-specific callsets.
[[rules]]
name = "merge_calls"
description = "Merge vartype-specific FDR-controlled calls (bcftools concat v2.3.2 wrapper)"
input = [
    "results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.SNV.variants.bcf",
    "results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.INS.variants.bcf",
    "results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.DEL.variants.bcf",
    "results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.MNV.variants.bcf",
    "results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.BND.variants.bcf",
    "results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.INV.variants.bcf",
    "results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.DUP.variants.bcf",
    "results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.REP.variants.bcf",
    "results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.SNV.variants.bcf.csi",
    "results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.INS.variants.bcf.csi",
    "results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.DEL.variants.bcf.csi",
    "results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.MNV.variants.bcf.csi",
    "results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.BND.variants.bcf.csi",
    "results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.INV.variants.bcf.csi",
    "results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.DUP.variants.bcf.csi",
    "results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.REP.variants.bcf.csi",
]
output = ["results/final-calls/SRR702070_group/SRR702070_group.some_id.variants.fdr-controlled.bcf"]
shell = """
bcftools concat --output {output} --output-type b -a \
  {input[0]} {input[1]} {input[2]} {input[3]} {input[4]} {input[5]} {input[6]} {input[7]} 2> {log}
"""
log = "logs/merge-calls/SRR702070_group/SRR702070_group.some_id.variants.log"

[rules.environment]
conda = "envs/bcftools.yaml"

# ---- upstream rule: convert_phred_scores ------------------------------------
[[rules]]
name = "convert_phred_scores"
description = "Decode phred scores to normal probabilities (varlociraptor decode-phred)"
input = ["results/final-calls/SRR702070_group/SRR702070_group.some_id.variants.fdr-controlled.bcf"]
output = ["results/final-calls/SRR702070_group/SRR702070_group.some_id.variants.fdr-controlled.normal-probs.bcf"]
shell = "varlociraptor decode-phred < {input} > {output} 2> {log}"
log = "logs/convert-phred-scores/SRR702070_group.some_id.variants.log"

[rules.environment]
conda = "envs/varlociraptor.yaml"

# ---- upstream rule: bcf_index (annotation-filtered calls) -------------------
[[rules]]
name = "bcf_index_filtered"
description = "Index the annotation-filtered calls (bcftools index v2.6.0 wrapper)"
input = ["results/calls/filtered/filtered_ann/SRR702070_group/some_id/SRR702070_group.variants.0.bcf"]
output = ["results/calls/filtered/filtered_ann/SRR702070_group/some_id/SRR702070_group.variants.0.bcf.csi"]
shell = "bcftools index {input} 2> {log}"
log = "logs/bcf-index/filtered_ann/SRR702070_group/some_id/SRR702070_group.variants.0.log"

[rules.environment]
conda = "envs/bcftools.yaml"

# ---- upstream rule: bcf_index (fdr-controlled calls) ------------------------
[[rules]]
name = "bcf_index_fdr_SNV"
description = "Index the FDR-controlled SNV calls (bcftools index v2.6.0 wrapper)"
input = ["results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.SNV.variants.bcf"]
output = ["results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.SNV.variants.bcf.csi"]
