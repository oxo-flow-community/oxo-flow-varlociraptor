"""
log = "logs/control-fdr/SRR702070_group/some_id/SRR702070_group.DEL.variants.log"

[rules.environment]
conda = "envs/varlociraptor.yaml"

[[rules]]
name = "control_fdr_MNV"
description = "FDR control for MNVs (varlociraptor control-fdr, local-smart, fdr 0.05)"
input = ["results/calls/filtered/SRR702070_group/some_id/SRR702070_group.variants.filtered_ann.bcf"]
output = ["results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.MNV.variants.bcf"]
shell = """
varlociraptor filter-calls control-fdr {input} --mode local-smart --var MNV \
