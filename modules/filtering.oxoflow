[[rules]]
name = "control_fdr_DUP"
description = "FDR control for duplications (varlociraptor control-fdr, local-smart, fdr 0.05)"
input = ["results/calls/filtered/SRR702070_group/some_id/SRR702070_group.variants.filtered_ann.bcf"]
output = ["results/calls/fdr-controlled/SRR702070_group/some_id/SRR702070_group.DUP.variants.bcf"]
