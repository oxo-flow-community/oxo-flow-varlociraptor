# Read mapping and BAM processing (upstream workflow/rules/trimming.smk +
# workflow/rules/mapping.smk).
#
# Rule map (upstream rule -> this module):
#   merge_trimmed_fastqs       -> mapping::merge_trimmed_fastqs_{r1,r2}
#                                 (no trimming configured -> raw passthrough)
#   map_reads_vg               -> mapping::map_reads_vg      (vg giraffe v9.9.0 wrapper)
#   postprocess_vg_alignments  -> mapping::postprocess_vg_alignments
#   sort_alignments            -> mapping::sort_alignments   (samtools sort v9.15.0 wrapper)
#   bam_index                  -> mapping::bam_index_sorted  (samtools index v9.15.0 wrapper;
#                                 feeds the UMI branch input, like upstream)
#   annotate_umis              -> mapping::annotate_umis     (umi_tools group, gated on
#                                 config.umi_read; output is snakemake temp())
#   mark_duplicates            -> mapping::mark_duplicates            (no UMI reads)
#                                 mapping::mark_duplicates_umi        (--BARCODE_TAG BX twin;
#                                 upstream get_markduplicates_input + get_markduplicates_extra)
#   splitncigarreads           -> mapping::splitncigarreads  (gatk wrapper v3.1.0, gated on
#                                 config.datatype == "rna"; output is snakemake temp())
#   bam_index                  -> mapping::bam_index_split   (results/split/{sample}.bai;
#                                 no ruleorder claim upstream, generic bam_index)
#   recalibrate_base_qualities -> mapping::recalibrate_base_qualities[_rna]
#                                 (three-way gate with consensus::recalibrate_base_qualities_consensus,
#                                 mirroring upstream get_recalibrate_quality_input)
#   apply_bqsr                 -> mapping::apply_bqsr[_rna]  (same three-way gate)
#
# Deviations (details in README.md):
#   * Fastq input paths come from config.reads_dir (upstream config/units.tsv
#     points at absolute /projects/... paths); raw reads pass through
#     merge_trimmed_fastqs unchanged because no adapters are configured.
#   * Read group is rendered with literal backslashes exactly as upstream.
#   * apply_bqsr declares results/recal/{sample}.bam as protected_output
#     (upstream `protected()`).
#   * Upstream switches the mark_duplicates input/extra and the BQSR input via
#     get_markduplicates_input/get_markduplicates_extra/get_recalibrate_quality_input;
#     the port models each branch as duplicate rules with the same outputs and
#     mutually exclusive `when` gates. The sorted/split BAM indexes are declared
#     by dedicated bam_index_* rules (upstream: generic bam_index with ruleorder
#     only where ApplyBQSR writes its own .bai).

[workflow]
name = "mapping"

# ---- upstream rule: merge_trimmed_fastqs (R1) ------------------------------
[[rules]]
name = "merge_trimmed_fastqs_r1"
description = "Merge (here: pass through) R1 reads into results/merged"
input = ["{config.reads_dir}/SRR702070_1.fastq.gz"]
output = ["results/merged/SRR702070_R1.fastq.gz"]
shell = "cat {input} > {output}"

# ---- upstream rule: merge_trimmed_fastqs (R2) ------------------------------
[[rules]]
name = "merge_trimmed_fastqs_r2"
description = "Merge (here: pass through) R2 reads into results/merged"
input = ["{config.reads_dir}/SRR702070_2.fastq.gz"]
output = ["results/merged/SRR702070_R2.fastq.gz"]
shell = "cat {input} > {output}"

# ---- upstream rule: map_reads_vg ------------------------------------------
# vg giraffe v9.9.0 wrapper, sorting none (64 threads, 63 for the BAM
# conversion as upstream).
[[rules]]
name = "map_reads_vg"
description = "Map reads to the HPRC v1.1 pangenome with vg giraffe (vg giraffe v9.9.0 wrapper)"
input = [
    "resources/pangenome.homo_sapiens.GRCh38.dist",
    "resources/pangenome.homo_sapiens.GRCh38.shortread.withzip.min",
    "resources/pangenome.homo_sapiens.GRCh38.longread.withzip.min",
    "resources/pangenome.homo_sapiens.GRCh38.shortread.zipcodes",
    "resources/pangenome.homo_sapiens.GRCh38.longread.zipcodes",
    "results/merged/SRR702070_R1.fastq.gz",
    "results/merged/SRR702070_R2.fastq.gz",
    "resources/pangenome.homo_sapiens.GRCh38.gbz",
    "resources/pangenome.homo_sapiens.GRCh38.ref_paths.txt",
]
output = ["results/mapped/vg/SRR702070.raw.bam"]
shell = """
(vg giraffe -p -t 64 -Z {input[7]} -f {input[5]} -f {input[6]} \
  --output-format BAM --ref-paths {input[8]} --parameter-preset default \
  | samtools view --threads 63 -o {output} --output-fmt BAM) 2> {log}
"""
log = "logs/mapped/vg/SRR702070.log"

[rules.resources]
threads = 64

[rules.environment]
conda = "envs/vg.yaml"

# ---- upstream rule: postprocess_vg_alignments ------------------------------
[[rules]]
name = "postprocess_vg_alignments"
description = "Fix pangenome contig names, fixmate, and add the read group"
input = ["results/mapped/vg/SRR702070.raw.bam"]
output = ["results/mapped/vg/SRR702070.bam"]
shell = """
# fresh-dir semantics: a failed attempt leaves a 0-byte output that the
# engine treats as up-to-date (live: sort_alignments could not read the header)
rm -f {output}
(samtools view {input} -H | \
 sed -E 's/(SN:GRCh38#0#chr)/SN:/; s/SN:M/SN:MT/' | \
 samtools reheader - {input} | \
 samtools fixmate - - | \
 samtools addreplacerg - -r "@RG\\tID:SRR702070\\tSM:SRR702070\\tPL:ILLUMINA") > {output} 2> {log}
"""
log = "logs/reheader/SRR702070.log"

[rules.environment]
conda = "envs/samtools.yaml"

# ---- upstream rule: sort_alignments ----------------------------------------
# samtools sort v9.15.0 wrapper (16 threads, 32000 MiB -> -m 1800M).
[[rules]]
name = "sort_alignments"
description = "Coordinate-sort the mapped BAM (samtools sort v9.15.0 wrapper)"
input = ["results/mapped/vg/SRR702070.bam"]
output = ["results/mapped/vg/SRR702070.sorted.bam"]
shell = """
tmpdir=$(mktemp -d) && \
samtools sort --threads 15 -o {output} --output-fmt BAM -m 1800M -T "$tmpdir/samtools_sort" {input} && \
rm -rf "$tmpdir"
"""
log = "logs/sort/vg/SRR702070.log"

[rules.resources]
threads = 16
memory = "32G"

[rules.environment]
conda = "envs/samtools.yaml"

# ---- upstream rule: bam_index (sorted bam) ---------------------------------
# samtools index v9.15.0 wrapper. Upstream `bam_index` has no ruleorder claim
# on the sorted BAM, so annotate_umis (UMI branch) consumes a declared index
# here; the default path does not need it (dedup/split have their own rules).
# Gated like its only consumer (annotate_umis) — upstream materializes the
# index only when a consumer requests it.
[[rules]]
name = "bam_index_sorted"
description = "Index the sorted BAM (samtools index v9.15.0 wrapper)"
when = "config.umi_read != \"\""
input = ["results/mapped/vg/SRR702070.sorted.bam"]
output = ["results/mapped/vg/SRR702070.sorted.bai"]
shell = "samtools index {input} {output} 2> {log}"
log = "logs/bam-index/SRR702070.log"

[rules.environment]
conda = "envs/samtools.yaml"

# ---- upstream rule: annotate_umis ------------------------------------------
# umi_tools group (no wrapper upstream, verbatim shell). Gated on a non-empty
# config.umi_read (upstream: the samples.tsv umi_read column being set, i.e.
# pd.notna). The annotated BAM is upstream temp() and the only input that
# changes downstream: get_markduplicates_input switches MarkDuplicates to it
# with --BARCODE_TAG BX. Upstream has no threads/resources on this rule.
# Note: get_annotate_umis_params (umi_len/umi-position) is dead code upstream
# — annotate_umis takes no such parameters, so none are rendered here.
[[rules]]
name = "annotate_umis"
description = "Extract UMIs into the BX tag with umi_tools group (upstream mapping.smk annotate_umis)"
when = "config.umi_read != \"\""
input = [
    "results/mapped/vg/SRR702070.sorted.bam",
    "results/mapped/vg/SRR702070.sorted.bai",
]
output = ["results/mapped/vg/SRR702070.annotated.bam"]
temporary = true
shell = "umi_tools group -I {input[0]} --paired --umi-separator : --output-bam -S {output[0]} &> {log}"
log = "logs/annotate_bam/vg/SRR702070.log"

[rules.environment]
conda = "envs/umi_tools.yaml"

# ---- upstream rule: mark_duplicates ----------------------------------------
# picard markduplicates v2.5.0 wrapper (3000 MiB, java overhead 0.3 -> -Xmx2100M).
# config.markduplicates_extra renders upstream get_markduplicates_extra
# (--TAG_DUPLICATE_SET_MEMBERS true when calc_consensus_reads is active;
# empty by default — the default-path command keeps the byte-identical shape
# modulo the trailing space). Gated on no UMI reads: upstream
# get_markduplicates_input would switch the input to the annotated BAM
# (mark_duplicates_umi twin below).
[[rules]]
name = "mark_duplicates"
description = "Mark PCR duplicates with picard MarkDuplicates (markduplicates v2.5.0 wrapper)"
when = "config.umi_read == \"\""
input = ["results/mapped/vg/SRR702070.sorted.bam"]
output = [
    "results/dedup/SRR702070.bam",
    "results/qc/dedup/SRR702070.metrics.txt",
]
shell = """
tmpdir=$(mktemp -d) && \
(picard MarkDuplicates -Xmx2100M -Djava.io.tmpdir="$tmpdir" \
  --VALIDATION_STRINGENCY LENIENT --INPUT {input} --TMP_DIR "$tmpdir" \
  --OUTPUT {output[0]} --METRICS_FILE {output[1]} {config.markduplicates_extra}) 2> {log} && \
rm -rf "$tmpdir"
"""
log = "logs/picard/dedup/SRR702070.log"

[rules.resources]
memory = "3G"

[rules.environment]
conda = "envs/picard.yaml"

# ---- upstream rule: mark_duplicates (UMI twin) -----------------------------
# Same picard markduplicates v2.5.0 wrapper; input is the annotated BAM
# (upstream get_markduplicates_input) and --BARCODE_TAG BX is appended
# (upstream get_markduplicates_extra UMI branch). Same outputs as
# mark_duplicates; the `when` gates are mutually exclusive.
[[rules]]
name = "mark_duplicates_umi"
description = "Mark PCR duplicates with picard MarkDuplicates on the UMI-annotated BAM (--BARCODE_TAG BX)"
when = "config.umi_read != \"\""
input = ["results/mapped/vg/SRR702070.annotated.bam"]
output = [
    "results/dedup/SRR702070.bam",
    "results/qc/dedup/SRR702070.metrics.txt",
]
shell = """
tmpdir=$(mktemp -d) && \
(picard MarkDuplicates -Xmx2100M -Djava.io.tmpdir="$tmpdir" \
  --VALIDATION_STRINGENCY LENIENT --INPUT {input} --TMP_DIR "$tmpdir" \
  --OUTPUT {output[0]} --METRICS_FILE {output[1]} {config.markduplicates_extra} --BARCODE_TAG BX) 2> {log} && \
rm -rf "$tmpdir"
"""
log = "logs/picard/dedup/SRR702070.log"

[rules.resources]
memory = "3G"

[rules.environment]
conda = "envs/picard.yaml"

# ---- upstream rule: bam_index (dedup bam) ----------------------------------
# samtools index v9.15.0 wrapper.
[[rules]]
name = "bam_index_dedup"
description = "Index the deduplicated BAM (samtools index v9.15.0 wrapper)"
input = ["results/dedup/SRR702070.bam"]
output = ["results/dedup/SRR702070.bai"]
shell = "samtools index {input} {output} 2> {log}"
log = "logs/bam-index/SRR702070.log"

[rules.environment]
conda = "envs/samtools.yaml"

# ---- upstream rule: splitncigarreads ----------------------------------------
# gatk SplitNCigarReads (wrapper v3.1.0: `gatk --java-options '{java_opts}'
# SplitNCIGARReads --reference --input --tmp-dir --output`; mem 1024 MiB,
# java overhead 0.3 -> -Xmx716M). Gated on config.datatype == "rna"
# (upstream get_recalibrate_quality_input RNA branch); the output is
# upstream temp().
[[rules]]
name = "splitncigarreads"
description = "Split N-cigar reads for RNA data with GATK SplitNCigarReads (wrapper v3.1.0)"
when = "config.datatype == \"rna\""
input = [
    "results/dedup/SRR702070.bam",
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta",
]
output = ["results/split/SRR702070.bam"]
temporary = true
shell = """
tmpdir=$(mktemp -d) && \
(gatk --java-options '-Xmx716M -Djava.io.tmpdir='"$tmpdir" SplitNCigarReads \
  --reference {input[1]} --input {input[0]} --tmp-dir "$tmpdir" \
  --output {output[0]}) 2> {log} && \
rm -rf "$tmpdir"
"""
log = "logs/gatk/splitNCIGARreads/SRR702070.log"

[rules.resources]
memory = "1G"

[rules.environment]
conda = "envs/gatk.yaml"

# ---- upstream rule: bam_index (split bam) ----------------------------------
# samtools index v9.15.0 wrapper. Upstream `bam_index` has no ruleorder claim
# on results/split/{sample}.bam, so the generic rule produces this index
# (dedicated rule here; recalibrate_base_qualities_rna/apply_bqsr_rna consume
# it like upstream). Gated like its consumers (recalibrate_base_qualities_rna/
# apply_bqsr_rna).
[[rules]]
name = "bam_index_split"
description = "Index the split-reads BAM (samtools index v9.15.0 wrapper)"
when = "config.datatype == \"rna\""
input = ["results/split/SRR702070.bam"]
output = ["results/split/SRR702070.bai"]
shell = "samtools index {input} {output} 2> {log}"
log = "logs/bam-index/SRR702070.log"

[rules.environment]
conda = "envs/samtools.yaml"

# ---- upstream rule: recalibrate_base_qualities -----------------------------
# gatk baserecalibratorspark v1.25.0 wrapper (8 threads, 1024 MiB ->
# -Xmx819M, --spark-master local[8]). Three-way gate with
# consensus::recalibrate_base_qualities_consensus (config.datatype != "rna" &&
# !consensus_activate) and mapping::recalibrate_base_qualities_rna
# (config.datatype == "rna"), mirroring upstream get_recalibrate_quality_input
# (rna checked first, then consensus).
[[rules]]
name = "recalibrate_base_qualities"
description = "Build the BQSR recalibration table (baserecalibratorspark v1.25.0 wrapper)"
when = "config.datatype != \"rna\" && !config.consensus_activate"
input = [
    "results/dedup/SRR702070.bam",
    "results/dedup/SRR702070.bai",
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta",
    "resources/genome.dna.homo_sapiens.GRCh38.111.dict",
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta.fai",
    "resources/variation.noiupac.vcf.gz",
    "resources/variation.noiupac.vcf.gz.tbi",
]
output = ["results/recal/SRR702070.grp"]
shell = """
tmpdir=$(mktemp -d) && \
(gatk --java-options '-Xmx819M -Djava.io.tmpdir='"$tmpdir" BaseRecalibratorSpark \
  --input {input[0]} --reference {input[2]} --tmp-dir "$tmpdir" \
  --output {output} --known-sites {input[5]} \
  -- --spark-runner LOCAL --spark-master local[8]) 2> {log} && \
rm -rf "$tmpdir"
"""
log = "logs/gatk/baserecalibrator/SRR702070.log"

[rules.resources]
threads = 8
memory = "1G"

[rules.environment]
conda = "envs/gatk.yaml"

# ---- upstream rule: recalibrate_base_qualities (RNA twin) ------------------
# Same baserecalibratorspark v1.25.0 wrapper; the BAM input switches to
# results/split/{sample}.bam(+.bai) (upstream get_recalibrate_quality_input
# RNA branch, checked before the consensus branch). Same outputs as the DNA
# rule; the `when` gates are mutually exclusive.
[[rules]]
name = "recalibrate_base_qualities_rna"
description = "Build the BQSR recalibration table from the split-reads BAM (baserecalibratorspark v1.25.0 wrapper)"
when = "config.datatype == \"rna\""
input = [
    "results/split/SRR702070.bam",
    "results/split/SRR702070.bai",
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta",
    "resources/genome.dna.homo_sapiens.GRCh38.111.dict",
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta.fai",
    "resources/variation.noiupac.vcf.gz",
    "resources/variation.noiupac.vcf.gz.tbi",
]
output = ["results/recal/SRR702070.grp"]
shell = """
tmpdir=$(mktemp -d) && \
(gatk --java-options '-Xmx819M -Djava.io.tmpdir='"$tmpdir" BaseRecalibratorSpark \
  --input {input[0]} --reference {input[2]} --tmp-dir "$tmpdir" \
  --output {output} --known-sites {input[5]} \
  -- --spark-runner LOCAL --spark-master local[8]) 2> {log} && \
rm -rf "$tmpdir"
"""
log = "logs/gatk/baserecalibrator/SRR702070.log"

[rules.resources]
threads = 8
memory = "1G"

[rules.environment]
conda = "envs/gatk.yaml"

# ---- upstream rule: apply_bqsr ---------------------------------------------
# gatk applybqsr v2.3.2 wrapper. The BAM index is produced by GATK itself
# (upstream ruleorder: apply_bqsr > bam_index). The .bam is protected as
# upstream (protected()). Three-way gate, like recalibrate_base_qualities
# (see its comment).
[[rules]]
name = "apply_bqsr"
description = "Apply BQSR with GATK ApplyBQSR (applybqsr v2.3.2 wrapper)"
when = "config.datatype != \"rna\" && !config.consensus_activate"
input = [
    "results/dedup/SRR702070.bam",
    "results/dedup/SRR702070.bai",
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta",
    "resources/genome.dna.homo_sapiens.GRCh38.111.dict",
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta.fai",
    "results/recal/SRR702070.grp",
]
output = [
    "results/recal/SRR702070.bam",
    "results/recal/SRR702070.bai",
]
protected_output = ["results/recal/SRR702070.bam"]
shell = """
tmpdir=$(mktemp -d) && \
(gatk --java-options '-Xmx164M -Djava.io.tmpdir='"$tmpdir" ApplyBQSR \
  --input {input[0]} --bqsr-recal-file {input[5]} --reference {input[2]} \
  --tmp-dir "$tmpdir" --output {output[0]}) 2> {log} && \
rm -rf "$tmpdir"
"""
log = "logs/gatk/gatk_applybqsr/SRR702070.log"

[rules.environment]
conda = "envs/gatk.yaml"

# ---- upstream rule: apply_bqsr (RNA twin) ----------------------------------
# Same applybqsr v2.3.2 wrapper; the BAM input switches to
# results/split/{sample}.bam(+.bai) (upstream get_recalibrate_quality_input
# RNA branch). Same outputs (protected .bam); the `when` gates are mutually
# exclusive.
[[rules]]
name = "apply_bqsr_rna"
description = "Apply BQSR with GATK ApplyBQSR on the split-reads BAM (applybqsr v2.3.2 wrapper)"
when = "config.datatype == \"rna\""
input = [
    "results/split/SRR702070.bam",
    "results/split/SRR702070.bai",
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta",
    "resources/genome.dna.homo_sapiens.GRCh38.111.dict",
    "resources/genome.dna.homo_sapiens.GRCh38.111.fasta.fai",
    "results/recal/SRR702070.grp",
]
output = [
    "results/recal/SRR702070.bam",
    "results/recal/SRR702070.bai",
]
protected_output = ["results/recal/SRR702070.bam"]
shell = """
tmpdir=$(mktemp -d) && \
(gatk --java-options '-Xmx164M -Djava.io.tmpdir='"$tmpdir" ApplyBQSR \
  --input {input[0]} --bqsr-recal-file {input[5]} --reference {input[2]} \
  --tmp-dir "$tmpdir" --output {output[0]}) 2> {log} && \
rm -rf "$tmpdir"
"""
log = "logs/gatk/gatk_applybqsr/SRR702070.log"

[rules.environment]
conda = "envs/gatk.yaml"
